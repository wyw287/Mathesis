{
  "name": "mathesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:contract && npm run check:client && npm run check:render && npm run check:agent && npm run check:storage && npm run check:store && npm run check:field && npm run check:scene && npm run check:cas && npm run check:matrix && npm run check:layout",
    "check:contract": "esbuild scripts/contract-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/contract-check.mjs --log-level=warning && node node_modules/.cache/contract-check.mjs",
    "check:client": "esbuild scripts/client-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/client-check.mjs --log-level=warning && node node_modules/.cache/client-check.mjs",
    "check:render": "esbuild scripts/render-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/render-check.cjs --log-level=warning && node node_modules/.cache/render-check.cjs",
    "check:agent": "esbuild scripts/agent-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/agent-check.cjs --log-level=warning && node node_modules/.cache/agent-check.cjs",
    "check:storage": "esbuild scripts/storage-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/storage-check.cjs --log-level=warning && node node_modules/.cache/storage-check.cjs",
    "check:store": "esbuild scripts/store-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/store-check.cjs --log-level=warning && node node_modules/.cache/store-check.cjs",
    "check:field": "esbuild scripts/field-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/field-check.cjs --log-level=warning && node node_modules/.cache/field-check.cjs",
    "check:scene": "esbuild scripts/scene-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/scene-check.cjs --log-level=warning && node node_modules/.cache/scene-check.cjs",
    "check:cas": "esbuild scripts/cas-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/cas-check.cjs --log-level=warning && node node_modules/.cache/cas-check.cjs",
    "check:matrix": "esbuild scripts/matrix-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/matrix-check.cjs --log-level=warning && node node_modules/.cache/matrix-check.cjs",
    "check:layout": "esbuild scripts/layout-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/layout-check.cjs --log-level=warning && node node_modules/.cache/layout-check.cjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "mathjs": "^13.2.0",
    "nerdamer": "^1.1.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
